{
  "name": "prime-horse-estoque",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev": "concurrently -n server,web -c yellow,cyan \"npm run dev:server\" \"npm run dev:web\"",
    "dev:server": "npm run dev --workspace server",
    "dev:web": "npm run dev --workspace web",
    "build": "npm run build --workspace web",
    "start": "npm run start --workspace server",
    "generate-vapid": "node server/scripts/generate-vapid.js",
    "generate-icons": "node scripts/generate-icons.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.0.1"
  }
}
