# Supabase (Settings > API do projeto)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# Web Push (gerar com: node server/scripts/generate-vapid.js)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT_EMAIL=mailto:contato@example.com

# Porta do servidor (Railway injeta PORT automaticamente)
PORT=8787

# Origem do frontend em dev (para CORS); em produção o backend serve o build do web/
WEB_ORIGIN=http://localhost:5173
